		</PackageReference>
		<PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="11.0.0" />
		<PackageReference Include="System.Text.Json" Version="11.0.0" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Jellyfin.Services\Jellyfin.Services.csproj" />
